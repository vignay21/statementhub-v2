# Supabase Cloud Database (PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://lllrsaddqgzdsqzmvnnt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI API Key (Optional, for AI Party Assistant)
GEMINI_API_KEY=your-gemini-api-key

# Application Access Protection (Optional)
# Set a secret passcode to restrict who can access the dashboard.
# Leave blank or unset to allow public/open access.
# Multiple codes can be separated by commas (e.g. Pass123,Pass456)
APP_ACCESS_CODE=your-secret-passcode
